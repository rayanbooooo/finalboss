# Supabase (Project Settings -> API in the Supabase dashboard).
# Without these the app still runs: accounts and positions fall back to
# localStorage instead of the database.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Your Bybit referral code, from https://www.bybit.com/en/affiliates
#
# Optional. Without it the sign-up link on the connect-a-key screen still works,
# it just attributes the signup to nobody - which is what the site did before
# this existed. With it, users who create a Bybit account through that link are
# attributed to you, and Bybit's affiliate programme pays a share of their
# trading fees including volume traded through this terminal's API.
NEXT_PUBLIC_BYBIT_REFERRAL_CODE=

# Real CME MNQ bars via Databento (https://databento.com). Paid.
#
# Optional. Without it /api/mnq/bars serves the deterministic simulator and the
# terminal badges every bar SIMULATED, which is the honest default: synthetic
# prices rendered in the same chrome as real ones is a trap. Deliberately not
# NEXT_PUBLIC — the key stays server-side so only the bars route can spend your
# Databento quota.
DATABENTO_API_KEY=

# Kronos forecast sidecar (see services/kronos).
#
# Optional. Without it /api/forecast returns available:false and the forecast
# panel explains how to switch it on. Setup detection is unaffected either way —
# forecasts are an overlay on the scanner, never a dependency of it.
KRONOS_SERVICE_URL=
# Shared secret for the sidecar. Auth is enforced only when this is set on both
# sides; leave blank for a sidecar that is not publicly reachable.
KRONOS_SERVICE_TOKEN=

# Pin one MNQ bar source, for debugging. "yahoo" or "simulated".
#
# Optional. Unset, the app prefers Databento when a key is present, then free
# real bars from Yahoo, then the simulator. Pin it when you need to tell a
# Yahoo outage apart from a parsing bug without editing code.
MNQ_FORCE_SOURCE=
